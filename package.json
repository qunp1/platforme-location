{
  "name": "nadorly",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --configLoader runner",
    "build": "vite build --configLoader runner",
    "preview": "vite preview --host 127.0.0.1 --configLoader runner",
    "test": "node --test tests/*.test.js",
    "tokens": "node scripts/build-design-tokens.mjs",
    "test:e2e": "playwright test",
    "api": "node server/start.js",
    "seed:generate": "node scripts/generate-demo-seed.mjs",
    "format": "prettier --write src server package.json vite.config.js .prettierrc.json",
    "format:check": "prettier --check src server package.json vite.config.js .prettierrc.json"
  },
  "dependencies": {
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "prettier": "3.6.2",
    "vite": "7.1.12"
  }
}
